# scitex-storage environment variables
#
# Copy this file to `.env` (gitignored) and edit values for your setup.
# CLI flags always override env vars when both are given. Variables
# follow the SciTeX ecosystem convention: SCITEX_<MODULE>_<NAME>.
#
# All variables below are consumed ONLY by the optional GUI plugin
# (`pip install scitex-storage[gui]`, src/scitex_storage/_django/) --
# the core scan/sweep/archive/find-duplicates CLI reads none of these.

# Django secret key for the standalone GUI server (`scitex-storage
# start-gui`). A random one is generated per-process if unset -- only
# set this if you need a stable secret across restarts.
# SCITEX_STORAGE_DJANGO_SECRET=<random-string>

# "hub" | "standalone" -- lets the same _django app run embedded inside
# scitex-hub or as its own standalone server (the browser tab title
# distinguishes the two). Defaults to "standalone"; scitex-hub's own
# mount overrides this to "hub" when it embeds the plugin.
# SCITEX_APP_MODE=standalone
