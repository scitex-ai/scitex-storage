# ~/.scitex/scitex-storage/tier.env -- per-host arguments for
# scitex-storage-tier.service. Values are shapes, not secrets.
#
# Run the same arguments WITHOUT --yes first and read the plan:
#   scitex-storage tier /volume1 --to scitex-nas-02 --target-used-percent 80
#
# Keep ROOT's filesystem at or below 80% used: move units untouched (no read,
# no write) for 180 days and at least 1 GiB, coldest first, at most 2 TiB and
# 200 units per night. The --remote-root default is ~/scitex-storage-archive
# on the destination host. Add `--exclude PATTERN` (rsync-style, relative to
# ROOT, repeatable) for anything that must never move, such as a database
# directory or the volume's own snapshot/recycle folders.
SCITEX_STORAGE_TIER_ARGS=/volume1 --to scitex-nas-02 --cold-after-days 180 --min-size 1G --target-used-percent 80 --max-bytes 2T --max-items 200

# Budget for the sweep that frees space from earlier runs (step 1 of the
# unit). Expired originals are deleted only when their remote copy re-hashes
# to the recorded digest within this time; anything slower stays staged.
SCITEX_STORAGE_TIER_SWEEP_ARGS=--max-items 200 --max-bytes 4398046511104 --max-entries 1000000 --max-seconds 14400
