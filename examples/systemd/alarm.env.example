# ~/.scitex/scitex-storage/alarm.env -- per-host arguments for
# scitex-storage-alarm.service. Values are shapes, not secrets.
#
# scitex-nas-03: watch the 11.9 TB pool that holds the fleet Postgres.
# Floors in GiB decide on a volume this large (the 85% rule does not).
# cards first; email (the scoped operator helper, outside the fleet DB)
# when the card store is unreachable -- the 2026-11-25 failure mode.
SCITEX_STORAGE_ALARM_ARGS=--path /volume1 --warn-free-gib 100 --crit-free-gib 30 --notify cards,email

# Optional: a different email helper honouring
# --event-id/--subject/--body-file/--dry-run.
# SCITEX_STORAGE_ALARM_EMAIL_COMMAND=/path/to/send.sh
