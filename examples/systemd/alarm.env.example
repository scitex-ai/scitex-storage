# ~/.scitex/scitex-storage/alarm.env -- per-host arguments for
# scitex-storage-alarm.service. Values are shapes, not secrets.
#
# scitex-nas-03: watch the 11.9 TB pool that holds the fleet Postgres.
# Floors in GiB decide on a volume this large (the 85% rule does not).
# email: direct SMTP outside the fleet DB, so it still works when the card
# store is the thing that broke (the 2026-11-25 failure mode).
SCITEX_STORAGE_ALARM_ARGS=--path /volume1 --warn-free-gib 100 --crit-free-gib 30 --notify email

# The email rail sends as the scitex-notification profile "ops". System
# alarms go From no-reply@ To dev@ (operator policy, 2026-11-27), never to a
# personal inbox. No password here: scitex-storage-alarm-with-secret.sh
# decrypts it from ~/.pw at start, into the alarm process only.
SCITEX_NOTIFICATION_PROFILE_OPS_FROM=no-reply@scitex.ai
SCITEX_NOTIFICATION_PROFILE_OPS_FROM_NAME=SciTeX storage alarm
SCITEX_NOTIFICATION_PROFILE_OPS_TO=dev@scitex.ai
# The no-reply mailbox's submission server (STARTTLS).
SCITEX_NOTIFICATION_PROFILE_OPS_SMTP_HOST=smtp.example.net
SCITEX_NOTIFICATION_PROFILE_OPS_SMTP_PORT=587

# Where the wrapper finds the ciphertext, and the gpg home holding its key
# (default: gpg's own home). Use absolute paths: systemd does not expand ~.
# SCITEX_STORAGE_ALARM_PASSWORD_GPG=/home/USER/.pw/no-reply@scitex.ai.gpg
# SCITEX_STORAGE_ALARM_GNUPGHOME=/home/USER/.pw/.gnupg-no-reply

# Optional: a different profile name (the wrapper fills the OPS password).
# SCITEX_STORAGE_ALARM_EMAIL_PROFILE=ops
